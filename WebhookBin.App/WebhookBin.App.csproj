<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BlazorBlueprint.Components" Version="3.14.1" />
      <PackageReference Include="FluentValidation" Version="12.1.1" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
      <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\WebhookBin.Infrastructure\WebhookBin.Infrastructure.csproj" />
    </ItemGroup>

    <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild">
        <Message Text="Building Tailwind CSS..." Importance="high" />
        <Exec Command="tailwindcss -i wwwroot/app.css -o wwwroot/dist/app.css" />
    </Target>

    <ItemGroup>
      <Folder Include="wwwroot\dist\" />
    </ItemGroup>

</Project>
