@using WebhookBin.App.Shared.Bins.Dtos
@inject CreateBinHandler createBinHandler;
@inject ToastService toast;
@inject ILogger<CreateBinModal> logger;

<BbDialog Open="@Open" OpenChanged="@OpenChanged">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Create Bin</BbDialogTitle>
            <BbDialogDescription>Create a new bin to start receiving requests and debugging them.</BbDialogDescription>
        </BbDialogHeader>
        <div>
            <div>
                <BbFormFieldInput TValue="string" @bind-Value="_binName" Label="Bin name" ErrorText="@(_error ? "Required field." : "")"/>
            </div>
        </div>
        <BbDialogFooter class="sm:justify-between">
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbDialogClose>
            <BbButton Loading="@_isLoading" LoadingText="Saving..." @onclick="CreateBinAsync">Create</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<ListBinDto> OnSuccess { get; set; }
    
    private string? _binName;
    private bool _isLoading;
    private bool _error;

    private async Task CreateBinAsync()
    {
        _error = string.IsNullOrWhiteSpace(_binName);
        if (_error) return;
        
        _isLoading = true;

        try
        {
            var result = await createBinHandler.Handle(new CreateBinCommand(_binName!));
            if (result.IsFailure())
            {
                toast.Error(result.Error?.Message ?? "Error creating bin");
                return;
            }
            toast.Success("Bin created successfully");
            _isLoading = false;
            
            await OnSuccess.InvokeAsync(result.Value);
            await OpenChanged.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error creating bin");
            toast.Error(ex.ToString());
        }
    }
}