@page "/bins/{Id:guid}"
@attribute [StreamRendering]

@using WebhookBin.App.Shared.Bins.Dtos

@inject ViewBinHandler Handler
@inject NavigationManager Navigation

@layout BinsWorkspaceLayout


<BbTypographyH1>
    @if (BinDetails is not null)
    {
        @BinDetails.Name
    }
    else
    {
        <BbSkeleton class="h-10 w-[250px]"></BbSkeleton>
    }
</BbTypographyH1>

@code {
    private BinDetailsDto? BinDetails;
    
    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await Handler.Handle(new ViewBinQuery(Id));
        if (result.IsFailure())
        {
            Navigation.NavigateTo("/bins");
            return;
        }

        BinDetails = result.Value;
    }
}