@page "/bins"
@using WebhookBin.App.Features.Bins.CreateBin
@using WebhookBin.App.Shared.Bins.Dtos

@layout BinsWorkspaceLayout

<div class="">
    <BbTypographyH1 class="mb-4">Your Bins</BbTypographyH1>
    @if (_bins.Count > 0)
    {
        <section class="mb-4">
            @foreach (var bin in _bins)
            {
                var binLink = $"/bins/{bin.PublicId}";
                <NavLink class="cursor-pointer" href="@binLink">
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle>@bin.Name</BbCardTitle>
                            <BbCardDescription>@bin.RequestAmount Request@(bin.RequestAmount is 0 or > 1 ? 's' : "")</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            <BbTypographyP>Created on @bin.CreatedAt.ToString("f")</BbTypographyP>
                        </BbCardContent>
                    </BbCard>
                </NavLink>
            }
        </section>
    }
    @if (_bins.Count == 0)
    {
        <BbAlert Variant="AlertVariant.Warning" class="mb-4">
            <BbAlertTitle>Empty Workspace</BbAlertTitle>
            <BbAlertDescription>Start receiving requests by creating a new bin with the button bellow.</BbAlertDescription>
        </BbAlert>
    }
    @if (_bins.Count >= MaxDemoBins && DemoMode)
    {
        <BbAlert Variant="AlertVariant.Info">
            <BbAlertTitle>Demo mode</BbAlertTitle>
            <BbAlertDescription>You achieved the maximum amount of bins available in demo mode.</BbAlertDescription>
        </BbAlert>
    }
    else
    {
        <BbButton @onclick="() => _isCreateModalOpen = true">Create Bin</BbButton>
    }
</div>

<CreateBinModal @bind-open="_isCreateModalOpen" OnSuccess="OnModalCreated" />

@code {
    private readonly List<ListBinDto> _bins = [];
    private const bool DemoMode = true;
    private const int MaxDemoBins = 1;
    
    private bool _isCreateModalOpen = false;

    private void OnModalCreated(ListBinDto newBin)
    {
        _bins.Add(newBin);
    }
}